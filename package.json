{
  "name": "peercheck-react",
  "private": true,
  "version": "1.0.0",
  "description": "PeerCheck – private peer evaluation for IT capstone teams (React + TypeScript + Vite + Firebase)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run src",
    "seed": "node scripts/seed.mjs",
    "test:rules": "npx -y firebase-tools@13.29.1 emulators:exec --only firestore --project peercheck-rules-test \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "firebase-admin": "12.7.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
